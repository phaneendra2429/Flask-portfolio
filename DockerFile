# Use an official Python runtime as a parent image
FROM python:3.12.5-slim

# Install pg_isready for DB readiness check
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory in the container
WORKDIR /app

# Copy the requirements file to the container
COPY requirements.txt .

# Install the dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy wait-for-db script and make it executable
COPY wait-for-db.sh /wait-for-db.sh
RUN chmod +x /wait-for-db.sh

# Copy the entire project to the container
COPY . .

# Expose the default port 5000
EXPOSE 5000

# Set the environment variables for Flask
ENV FLASK_APP=app.py
ENV FLASK_RUN_HOST=0.0.0.0
ENV FLASK_ENV=production

# Wait for DB, create the resume setting if needed, then start Gunicorn.
# The migration is idempotent, so it is safe on every container start.
CMD ["/wait-for-db.sh", "sh", "-c", "python migrate_resume.py && exec gunicorn --bind 0.0.0.0:5000 --workers 2 app:app"]
